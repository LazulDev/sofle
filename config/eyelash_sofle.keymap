#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_es.h"

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    rgb_brightness_encoder: rgb_brightness_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;

        tap-ms = <100>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        // Si presiono normal escribe 5, si mantengo actua como un f5
        // &num_f F5 N5
        num_f: num_function {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM_FUNCTION";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };


        td_copy: tap_dance_copy {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C>, <&kp LC(C)>;
        };

        td_paste: tap_dance_paste {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp V>, <&kp LC(V)>;
        };

        spanish_open_punctuation: spanish_open_punctuation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
            bindings = <&kp ES_IEXCL>, <&kp ES_IQMARK>;
        };

        spanish_question_quote: spanish_question_quote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
            bindings = <&kp ES_SINGLE_QUOTE>, <&kp ES_QMARK>;
        };

        spanish_minus_underscore: spanish_minus_underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
            bindings = <&kp ES_MINUS>, <&kp ES_UNDER>;
        };
       

    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };

    };

       macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;
 
            label = "SHIFT_MCLK";
        };
    };
    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC          &kp N1           &kp N2        &kp N3        &kp N4       &kp N5   &kp UP_ARROW      &kp N6  &kp N7     &kp N8     &kp N9       &kp N0                    &kp BACKSPACE
&kp TAB          &kp Q            &kp W         &kp E         &kp R        &kp T    &kp DOWN_ARROW    &kp Y   &kp U      &kp I      &kp O        &kp P                     &spanish_question_quote
&kp CAPSLOCK     &kp A            &kp S         &kp D         &kp F        &kp G    &kp LEFT_ARROW    &kp H   &kp J      &kp K      &kp L        &kp ES_N_TILDE            &kp ES_ACUTE
&kp LSHFT        &kp Z            &kp X         &kp C         &kp V        &kp B    &kp RIGHT_ARROW   &kp N   &kp M      &kp COMMA  &kp DOT      &spanish_minus_underscore &spanish_open_punctuation
&kp C_MUTE        &kp LCTRL       &kp LEFT_ALT  &kp SPACE     &kp LEFT_GUI &mo 1    &kp ENTER         &mo 2   &kp SPACE  &kp RALT   &kp DELETE   &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            display-name = "Write";
        };

        layer_1 {
            bindings = <
&kp F1      &kp F2      &kp F3       &kp F4       &kp F5        &kp F6    &mmv MOVE_UP    &kp F7  &kp F8         &kp F9         &kp F10         &kp F11  &kp F12
&none       &none       &kp ES_PLUS  &kp ES_LBKT  &kp ES_RBKT   &none     &mmv MOVE_DOWN  &none   &none          &kp UP_ARROW   &none           &none    &none
&none       &kp ES_LT   &kp ES_GT    &kp ES_LBRC  &kp ES_RBRC   &none     &mmv MOVE_RIGHT &none   &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none    &none
&trans      &none       &none        &none        &none         &none     &mmv MOVE_LEFT  &none   &none          &none          &none           &none    &none           
&mkp LCLK   &trans      &trans       &trans       &none         &none     &none           &trans  &none          &trans         &trans          &none
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "Symbols";
        };

        layer_2 {
            bindings = <
&out OUT_TOG   &none        &none           &bt BT_CLR    &bt BT_CLR_ALL &none        &rgb_ug RGB_SPI    &none       &none           &none             &none       &none       &none
&none      &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &rgb_ug RGB_SPD    &none       &none           &none             &none       &none        &none
&none      &none            &none           &none         &none         &none         &rgb_ug RGB_EFR    &none       &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &none        &none
&none      &none            &none           &none         &none         &none         &rgb_ug RGB_EFF    &none       &none           &none             &none       &none        &none 
&rgb_ug RGB_TOG &none       &none           &none         &none         &none         &none              &none       &none           &none             &none       &none
            >;
            sensor-bindings = <&rgb_brightness_encoder>;
            display-name = "BT | RGB | Sound";
        };


    };
};
